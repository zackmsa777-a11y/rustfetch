{
  // Sample fastfetch config for import tests
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {
    "multithreading": true
  },
  "logo": {
    "source": "arch",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "preserveAspectRatio": true
  },
  "display": {
    "separator": " -> ",
    "color": {
      "keys": "blue"
    },
    "brightColor": false
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "33"
    },
    {
      "type": "terminalfont",
      "key": "Term Font"
    },
    {
      "type": "localip",
      "key": "IP"
    },
    {
      "type": "poweradapter",
      "key": "AC"
    },
    {
      "type": "wmtheme",
      "key": "WM Theme"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": ["/"]
    },
    {
      "type": "weather",
      "key": "Weather"
    },
    "break",
    "colors"
  ],
  "stat": true
}
